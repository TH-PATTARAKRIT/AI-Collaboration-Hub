{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TH-PATTARAKRIT/AI-Collaboration-Hub/schemas/room-a-batch-event-v1.json",
  "title": "ROOM A Batch Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "idempotency_key",
    "batch_id",
    "attempt",
    "authority_reference",
    "execution_lineage_id",
    "producer_role",
    "consumer_role",
    "corpus_membership_sha256",
    "module_ids",
    "module_count",
    "assigned_module_count",
    "received_module_count",
    "input_manifest_sha256",
    "output_manifest_sha256",
    "handoff_artifact_id",
    "handoff_sha256",
    "payload_manifest_artifact_id",
    "parent_event_id",
    "cfc_revisions",
    "critical_crq_count",
    "high_crq_count",
    "medium_crq_count",
    "low_crq_count",
    "open_crq_ids",
    "gap_count",
    "runtime_required_count",
    "blocking_dependencies",
    "proof_layer",
    "created_at",
    "state"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EVT-[A-Z0-9-]+$"},
    "event_type": {
      "type": "string",
      "enum": [
        "A1_HANDOFF_READY",
        "A2_CRQ_OPENED",
        "A1_CRQ_RESPONSE_READY",
        "A2_MIXED_DISPOSITION_READY",
        "A2_REVIEW_READY",
        "A3_CHALLENGE_READY",
        "MASTER_ROUTE_A3",
        "MASTER_RETURN_A1",
        "MASTER_RETURN_A2",
        "MASTER_RETURN_A3",
        "MASTER_AUTO_CONTINUE",
        "HOLD"
      ]
    },
    "idempotency_key": {"type": "string", "pattern": "^[A-Z0-9-]+:[A-Z0-9_]+:[a-f0-9]{64}:[1-9][0-9]*$", "maxLength": 256},
    "batch_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "attempt": {"type": "integer", "minimum": 1},
    "authority_reference": {"type": "string", "pattern": "^[A-Z0-9._-]+$", "maxLength": 128},
    "execution_lineage_id": {"type": "string", "pattern": "^[A-Z0-9._-]+$", "maxLength": 128},
    "producer_role": {"type": "string", "enum": ["A1", "A2", "A3", "MASTER", "CONTROLLER"]},
    "consumer_role": {"type": "string", "enum": ["A1", "A2", "A3", "MASTER", "CONTROLLER"]},
    "corpus_membership_sha256": {"$ref": "#/$defs/sha256"},
    "module_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9-]+$"}},
    "module_count": {"type": "integer", "minimum": 1},
    "assigned_module_count": {"type": "integer", "minimum": 1},
    "received_module_count": {"type": "integer", "minimum": 1},
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "output_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "handoff_artifact_id": {"type": "string", "pattern": "^[A-Z0-9._-]+$", "maxLength": 128},
    "handoff_sha256": {"$ref": "#/$defs/sha256"},
    "payload_manifest_artifact_id": {"type": "string", "pattern": "^[A-Z0-9._-]+$", "maxLength": 128},
    "parent_event_id": {"type": ["string", "null"], "pattern": "^EVT-[A-Z0-9-]+$"},
    "cfc_revisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 128}},
    "critical_crq_count": {"type": "integer", "minimum": 0},
    "high_crq_count": {"type": "integer", "minimum": 0},
    "medium_crq_count": {"type": "integer", "minimum": 0},
    "low_crq_count": {"type": "integer", "minimum": 0},
    "open_crq_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CRQ-[A-Z0-9._-]+$", "maxLength": 128}},
    "gap_count": {"type": "integer", "minimum": 0},
    "runtime_required_count": {"type": "integer", "minimum": 0},
    "blocking_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9._-]+$"}},
    "proof_layer": {"type": "string", "enum": ["STATIC_SOURCE_ONLY", "INFERENCE_DECLARED"]},
    "crq_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CRQ-[A-Z0-9._-]+$", "maxLength": 128}},
    "crq_disposition": {"type": "string", "enum": ["OPEN", "ANSWERED_RESTRICTED"]},
    "capsule_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cfc_id", "revision", "disposition", "next_role"],
        "properties": {
          "cfc_id": {"type": "string", "pattern": "^CAP-[A-Z0-9-]+$", "maxLength": 128},
          "revision": {"type": "string", "pattern": "^r[1-9][0-9]*$"},
          "disposition": {"type": "string", "enum": ["PASS_RECOMMENDATION", "CONDITIONAL_PASS_RECOMMENDATION", "REJECT_RETURN"]},
          "next_role": {"type": "string", "enum": ["A1", "A3"]}
        }
      }
    },
    "source_batch_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "target_batch_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "hold_scope": {"type": "string", "enum": ["BATCH_LOCAL", "WAVE", "GLOBAL"]},
    "hold_reason_code": {"type": "string", "pattern": "^[A-Z0-9._-]+$", "maxLength": 128},
    "finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9._-]+$", "maxLength": 128}},
    "created_at": {"type": "string", "format": "date-time"},
    "state": {"type": "string", "enum": ["READY", "ACTION_REQUIRED", "ANSWER_READY", "CLAIMED", "INPUT_VERIFIED", "PROCESSING", "OUTPUT_READY", "CONSUMED", "HOLD", "REJECTED"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
